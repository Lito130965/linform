# Linform configuration. Copy to .env and edit; every value below is a default,
# so an empty file runs a working service.
#
#   cp .env.example .env
#
# Nothing here is required to start. What IS required before exposing the
# service to anyone else is an authentication section — see "Access".

# ---------------------------------------------------------------- Access
# With none of these set, authentication is OFF. That is intended for local
# development only: every endpoint, including template management, is open.

# Accounts. Set both to enable the login screen. This user is created (and its
# password re-synced) on every start, so the env file stays the source of truth
# for the one account that can never be locked out. It then creates editor
# users and render API keys from the UI.
LINFORM_SUPERUSER=
LINFORM_SUPERUSER_PASSWORD=

# Static tokens, for machine-to-machine use without accounts.
# render: rendering only — what a consuming application gets.
# admin:  everything, including template and asset management.
# api:    legacy single token, counts as both. Prefer the two above.
LINFORM_RENDER_TOKEN=
LINFORM_ADMIN_TOKEN=
LINFORM_API_TOKEN=

# How long a browser session stays valid.
LINFORM_SESSION_TTL_HOURS=168

# Login throttling. Verifying a password is deliberately expensive, so an
# unthrottled endpoint is both a brute-force target and a way to starve the
# renderer of CPU. Per account: lock after N consecutive failures. Per client
# address: a rate limit for the path where no account exists to lock (0 = off).
LINFORM_MAX_LOGIN_FAILURES=5
LINFORM_LOGIN_LOCKOUT_MINUTES=15
LINFORM_LOGIN_RATE_PER_MINUTE=20

# ---------------------------------------------------------------- Storage
# SQLite by default so the service runs with zero configuration. docker-compose
# overrides this with PostgreSQL, which is what a deployment should use.
LINFORM_DATABASE_URL=sqlite+aiosqlite:///./linform.db

# ---------------------------------------------------------------- Rendering
# One render costs roughly a quarter of a second of CPU and is single-threaded,
# so throughput is about (workers / cost). See "Performance" in the README, and
# measure your own hardware with scripts/loadtest.py.
LINFORM_RENDER_MAX_WORKERS=2

# In-flight ceiling; past it renders are refused with 429 and Retry-After
# instead of queueing. 0 derives it as workers x 2.
LINFORM_RENDER_MAX_CONCURRENCY=0

# Hard timeout for a single render.
LINFORM_RENDER_TIMEOUT_SECONDS=30

# Fail a render when the payload is missing a placeholder, instead of quietly
# rendering an empty value. The editor previews leniently regardless.
LINFORM_STRICT_PLACEHOLDERS=true

# ---------------------------------------------------------------- Security
# A template is untrusted input: left on, it could make the SERVER fetch
# internal addresses (SSRF). Off means data: URIs and uploaded assets only.
# When on, restrict it to hosts you control.
LINFORM_ALLOW_EXTERNAL_URLS=false
LINFORM_ALLOWED_URL_HOSTS=[]

# ---------------------------------------------------------------- Observability
# JSON logs for a collector; plain text is friendlier in a terminal. The request
# body is never logged either way.
LINFORM_JSON_LOGS=false
LINFORM_LOG_LEVEL=INFO

# Prometheus metrics at /metrics, behind the render role. Off by default
# because the series are labelled by template code, so scraping reveals which
# forms this deployment runs.
LINFORM_METRICS_ENABLED=false

# --------------------------------------------------------------------- Caching
# How long a process may keep serving the version a template code resolved to.
# The process that publishes or rolls back drops its own entry at once, so this
# is the lag seen by OTHER processes only — and the container runs one, so a
# single-container deployment never sees it. 0 turns the cache off and every
# render asks the database.
LINFORM_TEMPLATE_CACHE_TTL_SECONDS=2
LINFORM_TEMPLATE_CACHE_MB=32

# Assets are content-addressed, so cached copies never go stale and this is
# purely a memory budget. Raise it if templates carry large images.
LINFORM_ASSET_CACHE_MB=64

# ---------------------------------------------------------------- AI assistant
# Optional and off without a key. Bring your own: any OpenAI-compatible chat
# completions endpoint (Gemini's compat layer, OpenRouter, Ollama, vLLM...).
LINFORM_AI_API_KEY=
LINFORM_AI_BASE_URL=https://api.openai.com/v1/
LINFORM_AI_MODEL=gpt-4o-mini
LINFORM_AI_TIMEOUT_SECONDS=60

# Test data may contain personal data, so the assistant does not see it unless
# the installation owner opts in.
LINFORM_AI_SEND_TEST_DATA=false

# ---------------------------------------------------------------- Compose only
# LINFORM_PORT=8100
# LINFORM_DB_PASSWORD=linform
